{
  "name": "news-brief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained daily news-brief pipeline. Runs on the Claude Max subscription via a Cowork scheduled task. No paid APIs, no external services.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run build && npm test",
    "brief:build": "tsx src/cli/build-brief.ts",
    "validate:draft": "tsx src/cli/validate-draft.ts",
    "check:draft": "tsx src/cli/check-draft.ts",
    "metrics:brief": "tsx src/cli/metrics-brief.ts",
    "render": "tsx src/cli/render-brief.ts",
    "publish:pages": "bash scripts/publish-pages.sh"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
